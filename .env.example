# Chaves dos canais novos em ingles (canal-survival e canal-classics).
#
# COMO USAR:
#   1. Copie este arquivo e renomeie a copia para  .env  (sem o ".example")
#   2. Preencha os valores depois do sinal de igual, sem espacos e sem aspas
#   3. NUNCA mande o .env para o GitHub (ja esta protegido no .gitignore)
#
# Onde conseguir cada uma esta explicado no MANUAL-PEDRO.md, etapa 3.

# --- Google / Gemini (a voz da narracao) ---
# PODE REAPROVEITAR a chave que voce ja usa nos outros canais: chave de API nao tem
# vinculo com canal de YouTube. Projeto novo no Google Cloud costuma exigir pagamento.
GEMINI_API_KEY=

# --- YouTube: o aplicativo (PODE REAPROVEITAR o par que voce ja usa) ---
# Estes dois identificam o APLICATIVO, nao o canal. Os dois canais novos usam o mesmo par.
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# --- YouTube: a autorizacao de CADA canal (estas sim sao novas, uma por canal) ---
# Gere no developers.google.com/oauthplayground, entrando com cada canal. NAO misture.
YT_REFRESH_TOKEN_SURVIVAL=
YT_REFRESH_TOKEN_CLASSICS=

# --- Opcional: onde guardar uma copia dos videos prontos ---
# Se deixar em branco, o programa simplesmente nao guarda copia (nao da erro).
SV_VIDEOS=
CL_VIDEOS=

# --- Opcional: onde esta o repositorio, se nao for C:\claude-skills ---
# CANAIS_REPO=C:\claude-skills
