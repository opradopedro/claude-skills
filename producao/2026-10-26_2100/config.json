   "text": "12 MINUTOS AO VIVO",
   "hl": true
  },
  {
   "start": 8.115,
   "end": 9.295,
   "text": "FALANDO DE COMIDA",
   "hl": false
  },
  {
   "start": 9.295,
   "end": 9.915,
   "text": "DO CACHORRO E",
   "hl": false
  },
  {
   "start": 9.915,
   "end": 11.031,
   "text": "DO APARTAMENTO PEQUENO",
   "hl": false
  },
  {
   "start": 11.031,
   "end": 11.595,
   "text": "DELA",
   "hl": false
  },
  {
   "start": 11.595,
   "end": 12.252,
   "text": "AÍ A GALERA",
   "hl": false
  },
  {
   "start": 12.252,
   "end": 13.041,
   "text": "PERGUNTOU SE ELA",
   "hl": false
  },
  {
   "start": 13.041,
   "end": 13.699,
   "text": "TAVA PRONTA PRA",
   "hl": false
  },
  {
   "start": 13.699,
   "end": 14.325,
   "text": "NOVEMBRO",
   "hl": false
  },
  {
   "start": 14.325,
   "end": 15.233,
   "text": "E ELA SIMPLESMENTE",
   "hl": false
  },
  {
   "start": 15.233,
   "end": 16.012,
   "text": "IGNOROU E MUDOU",
   "hl": false
  },
  {
   "start": 16.012,
   "end": 16.949,
   "text": "DE ASSUNTO",
   "hl": false
  },
  {
   "start": 16.949,
   "end": 17.69,
   "text": "NEM A ROCKSTAR",
   "hl": false
  },
  {
   "start": 17.69,
   "end": 18.959,
   "text": "NEM ELA CONFIRMAM",
   "hl": false
  },
  {
   "start": 18.959,
   "end": 19.555,
   "text": "MAS O ROSTO",
   "hl": false
  },
  {
   "start": 19.555,
   "end": 20.002,
   "text": "E A VOZ",
   "hl": false
  },
  {
   "start": 20.002,
