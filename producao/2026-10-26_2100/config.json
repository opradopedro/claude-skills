   "text": "FEZ A PRIMEIRA",
   "hl": false
  },
  {
   "start": 4.184,
   "end": 4.612,
   "text": "LIVE",
   "hl": false
  },
  {
   "start": 4.612,
   "end": 5.191,
   "text": "E FUGIU DO",
   "hl": false
  },
  {
