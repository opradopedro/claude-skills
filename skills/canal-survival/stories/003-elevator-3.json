 "lineas": [
  {
   "texto": "Part three. The broadcast said: not even for a voice you know.",
   "pausa": 0.8,
   "vel": 0.88
  },
  {
   "texto": "For two nights nothing knocked. I almost believed it had left.",
   "pausa": 0.7
  },
  {
   "texto": "Then it came back, and it knocked the way my sister knocks. Two fast, one slow.",
   "pausa": 1.0,
   "vel": 0.85
  },
  {
   "texto": "And then it used her voice.",
   "pausa": 0.9,
   "vel": 0.82
  },
  {
   "texto": "My sister died four years ago.",
   "pausa": 1.0,
   "vel": 0.8
  },
  {
   "texto": "It said my name. Then it said the nickname only she ever used.",
   "pausa": 0.8
  },
  {
   "texto": "It was not remembering her. It was remembering me.",
   "pausa": 0.8,
   "vel": 0.84
  },
  {
   "texto": "Every word I had said out loud in nine days. So I stopped talking.",
   "pausa": 1.0,
   "vel": 0.82
  },
  {
   "texto": "Part four, {when_next}.",
   "pausa": 0.3,
   "vel": 0.88
  }
 ],
