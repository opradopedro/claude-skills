 "lineas": [
  {
   "texto": "Regla número uno: si alguien toca tu ventana después de medianoche, no abras la cortina.",
   "pausa": 0.8,
   "vel": 0.86
  },
  {
   "texto": "Vivo en un cuarto piso.",
   "pausa": 0.6
  },
  {
   "texto": "Anoche, a las dos de la mañana, alguien tocó mi ventana. Tres veces.",
   "pausa": 1.2
  },
  {
   "texto": "Pensé que era una rama. En mi calle no hay árboles.",
   "pausa": 0.6
  },
  {
   "texto": "Volvieron a tocar. Y una voz susurró mi nombre.",
   "pausa": 0.6
  },
  {
   "texto": "No pude evitarlo. Abrí la cortina.",
   "pausa": 1.0
  },
  {
   "texto": "Afuera no había nadie. La cara estaba del lado de adentro del vidrio.",
   "pausa": 1.0,
   "vel": 0.84
  },
  {
   "texto": "Regla número dos: si ya abriste la cortina... no te des la vuelta.",
   "pausa": 0.3,
   "vel": 0.82
  }
 ],
