 "lineas": [
  {
   "texto": "Parte dos. La Llorona le preguntó si era su hijo. Él no dijo nada.",
   "pausa": 0.7,
   "vel": 0.86
  },
  {
   "texto": "Mi prima gritó su nombre, y la mujer se hundió en el agua.",
   "pausa": 0.9
  },
  {
   "texto": "Nadie durmió. El llanto daba vueltas alrededor de las carpas.",
   "pausa": 0.9
  },
  {
   "texto": "Al amanecer, él ya no estaba.",
   "pausa": 0.8
  },
  {
   "texto": "Lo encontraron sentado en la orilla, empapado, mirando el río.",
   "pausa": 0.7
  },
  {
   "texto": "Nunca volvió a hablar. Solo repite una frase, cada noche, a medianoche.",
   "pausa": 1.0
  },
  {
   "texto": "Ya encontré a mi mamá.",
   "pausa": 0.3,
   "vel": 0.76
  }
 ],
