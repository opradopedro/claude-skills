 "lineas": [
  {
   "texto": "Si escuchas a una mujer llorar cerca del río, aléjate. Si la escuchas lejos... ya está aquí.",
   "pausa": 1.0,
   "vel": 0.86
  },
  {
   "texto": "Mi prima acampó con sus amigos junto a un río. A medianoche, oyeron el llanto.",
   "pausa": 0.9
  },
  {
   "texto": "Una mujer de blanco caminaba por la orilla, con el cabello tapándole la cara.",
   "pausa": 0.6
  },
  {
   "texto": "Uno de ellos le gritó: ¿señora, está bien?",
   "pausa": 0.8
  },
  {
   "texto": "Ella dejó de llorar. Y en un parpadeo... estaba frente a él.",
   "pausa": 0.9,
   "vel": 0.84
  },
  {
   "texto": "Le preguntó: ¿tú eres mi hijo?",
   "pausa": 1.0,
   "vel": 0.78
  },
  {
   "texto": "Él no contestó. Y ella... empezó a sonreír.",
   "pausa": 1.0,
   "vel": 0.82
  },
  {
   "texto": "Parte dos, mañana, {dia_siguiente}.",
   "pausa": 0.3,
   "vel": 0.88
  }
 ],
