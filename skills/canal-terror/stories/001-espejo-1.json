 "lineas": [
  {
   "texto": "Anoche, el espejo de mi baño tocó dos veces. Desde adentro.",
   "pausa": 1.0,
   "vel": 0.88
  },
  {
   "texto": "Mi abuela cubría los espejos a medianoche. Para que no se acostumbren a vernos, decía.",
   "pausa": 0.6
  },
  {
   "texto": "Cuando murió, nadie los volvió a cubrir.",
   "pausa": 0.8
  },
  {
   "texto": "Una noche, me lavé la cara y levanté la vista.",
   "pausa": 0.4
  },
  {
   "texto": "Mi reflejo tardó un segundo en levantar la suya.",
   "pausa": 0.8,
   "vel": 0.85
  },
  {
   "texto": "Y luego... sonrió. Yo no estaba sonriendo.",
   "pausa": 1.0,
   "vel": 0.82
  },
  {
   "texto": "Lo tapé con una sábana. Pero anoche, debajo de la tela, escuché mi propia voz.",
   "pausa": 0.7
  },
  {
   "texto": "Me dijo: déjame salir.",
   "pausa": 1.0,
   "vel": 0.8
  },
  {
   "texto": "Parte dos, mañana a las nueve de la noche.",
   "pausa": 0.3,
   "vel": 0.88
  }
