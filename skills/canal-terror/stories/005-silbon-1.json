 "lineas": [
  {
   "texto": "Si escuchas un silbido cerca, tranquilo. Si lo escuchas lejos... corre.",
   "pausa": 1.0,
   "vel": 0.86
  },
  {
   "texto": "Es el Silbón, el espanto de los llanos de Venezuela y Colombia.",
   "pausa": 0.6
  },
  {
   "texto": "Un alma en pena, alta como un árbol, con sombrero, cargando un saco de huesos.",
   "pausa": 0.6
  },
  {
   "texto": "Su silbido sube nota por nota. Y engaña.",
   "pausa": 1.6
  },
  {
   "texto": "Cuando suena lejos... es porque ya está a tu lado.",
   "pausa": 1.0,
   "vel": 0.84
  },
  {
   "texto": "Mi tío volvía a casa por un camino de tierra, de madrugada.",
   "pausa": 0.6
  },
  {
   "texto": "Escuchó el silbido. Muy, muy lejos.",
   "pausa": 1.4
  },
  {
   "texto": "Y detrás de él, alguien empezó a contar huesos.",
   "pausa": 1.0,
   "vel": 0.84
  },
  {
   "texto": "Parte dos, mañana, {dia_siguiente}.",
   "pausa": 0.3,
   "vel": 0.88
  }
 ],
